{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "Lua 5.1",
  "runtime.builtin": {
    "basic": "disable",
    "debug": "disable",
    "io": "disable",
    "math": "disable",
    "os": "disable",
    "package": "disable",
    "string": "disable",
    "table": "disable",
    "utf8": "disable"
  },
  "diagnostics.globals": [
    "DEFAULT_CHAT_FRAME",
    "UISpecialFrames",
    "SlashCmdList",
    "MapCanvasPinMixin",
    "MapCanvasDataProviderMixin",
    "GetQuestDifficultyColor",
    "WorldMapFrame",
    "describe",
    "it"
  ],
  "workspace.library": [
    "tools/wow-api/Annotations/Core"
  ],
  "workspace.ignoreDir": [
    "tools/lua",
    "tests"
  ]
}
